# Copy this file to `.env` and fill in the values from your Firebase project
# (Firebase console ▸ Project settings ▸ Your apps ▸ Web app ▸ SDK setup and configuration).
# Leave the Firebase values empty to run in DEMO MODE (data stays in your browser).

VITE_APP_NAME=TeamTrack
VITE_APP_TAGLINE=Plan, track and review team progress

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Optional — Google Drive + Google Sheets (SETUP.md, part 3)
VITE_GOOGLE_CLIENT_ID=
# Optional — OneDrive and "Continue with Microsoft" (SETUP.md, part 4)
VITE_MS_CLIENT_ID=

# Optional — "Email me a sign-in link". Leave false on the free Spark plan: Firebase sends
# at most 5 of these emails per day for the whole site. Email + password works without it.
VITE_ENABLE_EMAIL_LINK=false

# Optional — students signed in with a personal email confirm their university email by code.
# Needs the Cloud Functions (Blaze plan, SETUP.md part 6). Leave false until they are deployed.
VITE_STUDENT_EMAIL_CHECK=false

# Local testing against the Firebase emulators (npm run emulators)
VITE_USE_EMULATORS=false
