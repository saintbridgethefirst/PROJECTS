rules_version = '2';

// ─────────────────────────────────────────────────────────────────────────────
//  Security rules — who may read and write what. Mirrors src/permissions.js and
//  src/rules-sim.js. Deploy with:  npx firebase deploy --only firestore
//  Test with:                      npm run test:rules   (needs Java)
// ─────────────────────────────────────────────────────────────────────────────
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    // Platform admins (you): a document at admins/{uid}, created by hand in the Firebase console.
    function isPlatformAdmin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    // Verified university email (.ac.uk, .edu, .ac.xx, .edu.xx, ETH, EPFL) — same list as ACADEMIC_EMAIL in model.js.
    // …or a university email proved by code (verifiedStudents/{uid} is written only by the server).
    function academic() {
      return (request.auth.token.email_verified == true
        && request.auth.token.email.lower().matches('^(.*@([a-z0-9-]+[.])+(ac[.][a-z]{2}|edu([.][a-z]{2})?)|.*@([a-z0-9-]+[.])*(ethz|epfl)[.]ch)$'))
        || (exists(/databases/$(database)/documents/verifiedStudents/$(request.auth.uid))
          && get(/databases/$(database)/documents/verifiedStudents/$(request.auth.uid)).data.until > request.time.toMillis());
    }
    // This year's Pro Education claims include team t (a fair-use cap of 25 teams a year per person).
    function eduClaimed(t) {
      let c = getAfter(/databases/$(database)/documents/eduClaims/$(request.auth.uid)).data;
      return c.year == request.time.year() && c.teams.hasAny([t]);
    }
    function validPlan(p) {
      return p is map && p.keys().hasOnly(['tier', 'edu', 'until', 'by', 'at', 'note'])
        && p.tier in ['free', 'pro', 'org'] && p.get('edu', false) is bool && p.get('until', 0) is number
        && p.get('note', '') is string && p.get('note', '').size() <= 200;
    }
    function validPlanRequest(d) {
      return d.keys().hasOnly(['teamId', 'teamName', 'members', 'wants', 'note', 'by', 'byName', 'email', 'at', 'status', 'decidedAt'])
        && d.wants in ['pro', 'edu', 'org'] && d.status == 'open' && d.by == request.auth.uid
        && d.note is string && d.note.size() <= 1000 && d.teamName is string && d.teamName.size() <= 80;
    }
    function myEmail() { return request.auth.token.get('email', '').lower(); }
    function verified() { return request.auth.token.get('email_verified', false) == true; }
    function teamPath(t) { return /databases/$(database)/documents/teams/$(t); }
    function memberPath(t) { return /databases/$(database)/documents/teams/$(t)/members/$(request.auth.uid); }
    function isMember(t) { return signedIn() && exists(memberPath(t)); }
    function myRole(t) { return get(memberPath(t)).data.roleId; }
    function can(t, p) {
      return isMember(t) && (myRole(t) == 'owner'
        || get(teamPath(t)).data.roles.get(myRole(t), {}).get('perms', {}).get(p, false) == true);
    }
    function canEditOwned(t, owner) {
      return can(t, 'tasks.editAll') || (can(t, 'tasks.editOwn') && owner == request.auth.uid);
    }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }

    // Automatic steps (Settings ▸ Workflow). Its own function, reading each field once with `let`,
    // so validTeam stays small (Firestore caps how much one request may evaluate).
    function validAutos(a) { return a == null || (a is map && validAutosFields(a)); }
    function validAutosFields(a) {
      let pt = a.get('partsTo', '');
      let rd = a.get('remindDays', 0);
      let cw = a.get('carryWarn', 0);
      return a.keys().hasOnly(['partsTo', 'tellWaiting', 'remindDays', 'carry', 'carryWarn', 'carryMakeWeeks'])
        && pt is string && pt.size() <= 40
        && a.get('tellWaiting', false) is bool
        && rd is int && rd >= 0 && rd <= 60
        && a.get('carry', false) is bool && a.get('carryMakeWeeks', false) is bool
        && cw is int && cw >= 0 && cw <= 10;
    }
    function validTeam(d) {
      return d.keys().hasOnly(['name', 'logo', 'ownerUid', 'createdAt', 'roles', 'fields', 'labels', 'weeks', 'weekNaming', 'phases', 'capacity', 'features', 'subteams', 'plan', 'archiveRev', 'workflow', 'leads', 'purchase', 'autos', 'github', 'currency', 'former', 'look'])
        && d.get('archiveRev', 0) is int
        && (!('former' in d) || (d.former is map && d.former.size() <= 300))
        && d.get('currency', 'GBP') in ['GBP', 'EUR', 'USD', 'INR', 'CHF', 'JPY', 'CNY', 'AUD', 'CAD']
        && d.get('look', 'friendly') in ['friendly', 'professional']
        && (d.get('github', null) == null || (d.github is map && d.github.keys().hasOnly(['repo', 'issues', 'done', 'owner', 'connectedAt', 'write', 'last']) && d.github.get('repo', '') is string && d.github.get('repo', '').size() <= 140))
        && (d.get('purchase', null) == null || (d.purchase is map && d.purchase.keys().hasOnly(['on', 'over']) && d.purchase.get('on', false) is bool
          && d.purchase.get('over', 0) is number && d.purchase.get('over', 0) >= 0 && d.purchase.get('over', 0) <= 100000000))
        && validAutos(d.get('autos', null))
        && d.get('leads', {}) is map && d.get('leads', {}).size() <= 300
        && (d.get('workflow', null) == null || (d.workflow is map && d.workflow.keys().hasOnly(['stages', 'moved', 'order', 'gates', 'next', 'done']) && d.workflow.stages is list && d.workflow.stages.size() >= 2 && d.workflow.stages.size() <= 10))
        && d.name is string && d.name.size() > 0 && d.name.size() <= 80
        && d.logo is string && d.logo.size() <= 220000
        && d.fields is list && d.fields.size() <= 30
        && d.weeks is list && d.weeks.size() <= 200
        && d.roles is map && d.labels is map
        && d.get('weekNaming', 'sequence') in ['sequence', 'calendar']
        && d.get('phases', []) is list && d.get('phases', []).size() <= 20
        && (d.get('capacity', 0) is number && d.get('capacity', 0) >= 0 && d.get('capacity', 0) <= 80)
        && d.get('features', {}) is map && d.get('features', {}).size() <= 30
        && d.get('subteams', []) is list && d.get('subteams', []).size() <= 20
        && (!('plan' in d) || validPlan(d.plan));
    }
    // A dissertation or thesis workspace: level, dates, chapters (word counts), the proposal draft, ticked checks
    function validDissertation(x) {
      return x is map
        && x.keys().hasOnly(['level', 'kind', 'start', 'handIn', 'dates', 'chapters', 'proposal', 'checks', 'setupAt'])
        && x.get('level', 'ug') in ['ug', 'masters', 'phd']
        && x.get('kind', 'people') in ['people', 'lab', 'data', 'literature']
        && x.get('start', '') is string && x.get('start', '').size() <= 10
        && x.get('handIn', '') is string && x.get('handIn', '').size() <= 10
        && x.get('dates', {}) is map && x.get('dates', {}).size() <= 6
        && x.get('chapters', []) is list && x.get('chapters', []).size() <= 20
        && x.get('proposal', {}) is map && x.get('proposal', {}).size() <= 9
        && x.get('checks', {}) is map && x.get('checks', {}).size() <= 120
        && x.get('setupAt', 0) is number;
    }
    // Account photo: an https link or a small uploaded image (data URL)
    function validPhoto(d) { return d.get('photo', '') is string && d.get('photo', '').size() <= 60000; }
    function validComment(d) {
      return d.keys().hasOnly(['taskId', 'authorUid', 'authorName', 'text', 'mentions', 'createdAt', 'editedAt'])
        && d.taskId is string && d.taskId.size() <= 64 && d.authorUid is string
        && d.authorName is string && d.authorName.size() <= 80
        && d.text is string && d.text.size() > 0 && d.text.size() <= 2000
        && d.mentions is list && d.mentions.size() <= 20
        && d.createdAt is number && d.get('editedAt', 0) is number;
    }
    function validMeeting(d) {
      return d.keys().hasOnly(['title', 'date', 'attendees', 'notes', 'actions', 'createdBy', 'createdByName', 'createdAt', 'updatedAt', 'updatedByName'])
        && d.title is string && d.title.size() <= 120 && d.date is string && d.date.size() <= 10
        && d.attendees is list && d.attendees.size() <= 50 && d.notes is string && d.notes.size() <= 20000
        && d.actions is list && d.actions.size() <= 50 && d.createdBy is string && d.createdAt is number;
    }
    function validNote(d) {
      return d.keys().hasOnly(['taskId', 'authorUid', 'authorName', 'date', 'text', 'images', 'createdAt', 'editedAt'])
        && d.taskId is string && d.taskId.size() <= 64 && d.authorUid is string && d.authorName is string && d.authorName.size() <= 80
        && d.date is string && d.date.size() <= 10 && d.text is string && d.text.size() <= 10000
        && d.images is list && d.images.size() <= 4 && d.createdAt is number;
    }
    function validPart(d) {
      return d.keys().hasOnly(['name', 'partNo', 'supplier', 'url', 'qty', 'unitCost', 'status', 'neededBy', 'orderedDate', 'receivedDate', 'taskId', 'budgetId', 'notes', 'extras', 'subteamId', 'createdBy', 'createdByName', 'createdAt', 'updatedAt', 'approval'])
        && validApproval(d.get('approval', null))
        && d.name is string && d.name.size() > 0 && d.name.size() <= 200
        && d.get('extras', []) is list && d.get('extras', []).size() <= 10
        && d.qty is number && d.qty >= 0 && d.qty <= 100000 && d.unitCost is number && d.unitCost >= 0 && d.unitCost <= 100000000
        && d.status in ['needed', 'ordered', 'received', 'cancelled'] && d.notes is string && d.notes.size() <= 2000
        && (d.get('url', '') == '' || (d.get('url', '') is string && d.get('url', '').matches('^https?://.*$')))
        && d.createdBy is string && d.createdAt is number;
    }
    // Purchase approvals (workflow step 3): a part's approval request and its decision.
    function validApproval(v) {
      return v == null || (v is map && v.keys().hasOnly(['status', 'by', 'byName', 'at', 'amount', 'approver', 'approverName', 'note', 'decidedAt'])
        && v.get('status', '') in ['waiting', 'approved', 'declined'] && v.get('amount', 0) is number
        && v.get('note', '') is string && v.get('note', '').size() <= 500 && v.get('by', '') is string);
    }
    // Asking is open to anyone (in their own name); deciding is for finance managers (not on their own
    // request) and the team owner, in their own name.
    function partApproval(t) {
      let v = request.resource.data.get('approval', null);
      let old = resource == null ? null : resource.data.get('approval', null);
      // A decision answers a request that is waiting, keeps who asked (so nobody approves their own by renaming
      // it), and is never made up on a new part.
      return v == old || v == null
        || (v.status == 'waiting' && v.by == request.auth.uid)
        || (v.status in ['approved', 'declined'] && v.get('approver', '') == request.auth.uid
          && old != null && old.get('status', '') == 'waiting' && v.get('by', '') == old.get('by', '')
          && (get(teamPath(t)).data.ownerUid == request.auth.uid || (can(t, 'finance.edit') && v.by != request.auth.uid)));
    }
    // With approvals on, an order costing more than the limit is only marked Ordered (or Received) once approved.
    function purchaseOk(t) {
      let pc = get(teamPath(t)).data.get('purchase', null);
      let d = request.resource.data;
      // Checked when a part becomes Ordered or Received, and again if its quantity or price changes after that.
      let out = d.status in ['ordered', 'received'] && (resource == null || !(resource.data.status in ['ordered', 'received'])
        || d.qty != resource.data.qty || d.unitCost != resource.data.unitCost);
      return pc == null || pc.get('on', false) != true || !out || d.qty * d.unitCost <= pc.get('over', 0)
        || (d.get('approval', null) != null && d.approval.status == 'approved');
    }
    // An approved order's cost only changes with it (finance managers excepted): change the cost, ask again.
    function costKept(t) {
      let old = resource.data.get('approval', null);
      let d = request.resource.data;
      return old == null || old.get('status', '') != 'approved' || d.get('approval', null) != old || can(t, 'finance.edit')
        || (d.qty == resource.data.qty && d.unitCost == resource.data.unitCost && d.get('extras', []) == resource.data.get('extras', []));
    }
    function validExpense(d) {
      return d.keys().hasOnly(['kind', 'amount', 'date', 'description', 'budgetId', 'payer', 'receiptUrl', 'receiptImage', 'taskId', 'partId', 'partIds', 'createdBy', 'createdByName', 'createdAt', 'updatedAt'])
        && d.kind in ['expense', 'income'] && d.amount is number && d.amount >= 0 && d.amount <= 100000000
        && d.date is string && d.date.size() <= 10 && d.description is string && d.description.size() <= 300
        && d.get('receiptImage', '') is string && d.get('receiptImage', '').size() <= 200000
        && (d.get('receiptUrl', '') == '' || (d.get('receiptUrl', '') is string && d.get('receiptUrl', '').matches('^https?://.*$')))
        && d.get('partIds', []) is list && d.get('partIds', []).size() <= 30
        && d.createdBy is string && d.createdAt is number;
    }
    function validBudget(d) {
      return d.keys().hasOnly(['currency', 'lines', 'updatedAt']) && d.currency is string && d.currency.size() <= 3
        && d.lines is list && d.lines.size() <= 50;
    }
    function validPaper(d) {
      return d.keys().hasOnly(['title', 'authors', 'year', 'venue', 'doi', 'url', 'notes', 'tags', 'status', 'taskIds', 'addedBy', 'addedByName', 'createdAt', 'updatedAt'])
        && d.title is string && d.title.size() > 0 && d.title.size() <= 500 && d.authors is string && d.authors.size() <= 500
        && d.notes is string && d.notes.size() <= 5000 && d.tags is list && d.tags.size() <= 20
        && (d.get('url', '') == '' || (d.get('url', '') is string && d.get('url', '').matches('^https?://.*$')))
        && d.status in ['to-read', 'reading', 'read'] && d.taskIds is list && d.taskIds.size() <= 20
        && d.addedBy is string && d.createdAt is number;
    }
    function validProfile(d) {
      return d.keys().hasOnly(['capacity', 'skills', 'away', 'updatedAt'])
        && d.get('capacity', 0) is number && d.get('capacity', 0) >= 0 && d.get('capacity', 0) <= 80
        && d.get('skills', []) is list && d.get('skills', []).size() <= 20 && d.get('away', []) is list && d.get('away', []).size() <= 30;
    }
    function validWhiteboard(d) {
      return d.keys().hasOnly(['name', 'createdBy', 'createdByName', 'createdAt', 'updatedAt'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 80 && d.createdBy is string && d.createdAt is number;
    }
    function validWbItem(d) {
      return d.keys().hasOnly(['boardId', 'kind', 'x', 'y', 'w', 'h', 'text', 'color', 'taskId', 'from', 'to', 'z', 'createdBy', 'updatedAt', 'shape', 'path'])
        && d.boardId is string && d.boardId.size() > 0 && d.boardId.size() <= 64
        && d.kind in ['note', 'text', 'title', 'task', 'link', 'shape', 'pen', 'frame']
        && d.get('shape', '') is string && d.get('shape', '').size() <= 12
        // path is a pen drawing: only the characters that make up "x,y x,y …" coordinates, so a stored
        // value can never carry markup into the SVG that draws it.
        && d.get('path', '') is string && d.get('path', '').size() <= 6000 && d.get('path', '').matches('^[0-9 .,-]*$')
        && d.x is number && d.y is number && d.w is number && d.h is number
        && d.text is string && d.text.size() <= 2000
        && d.get('color', '') is string && d.get('color', '').size() <= 20
        && d.get('taskId', '') is string && d.get('taskId', '').size() <= 64
        && d.get('from', '') is string && d.get('from', '').size() <= 64 && d.get('to', '') is string && d.get('to', '').size() <= 64
        && d.createdBy is string;
    }
    function validRisk(d) {
      return d.keys().hasOnly(['title', 'detail', 'likelihood', 'impact', 'ownerUid', 'status', 'mitigation', 'taskIds', 'reviewDate', 'createdBy', 'createdByName', 'createdAt', 'updatedAt'])
        && d.title is string && d.title.size() > 0 && d.title.size() <= 200 && d.detail is string && d.detail.size() <= 2000
        && d.likelihood is number && d.likelihood >= 1 && d.likelihood <= 5 && d.impact is number && d.impact >= 1 && d.impact <= 5
        && d.status in ['open', 'mitigating', 'closed'] && d.mitigation is string && d.mitigation.size() <= 2000
        && d.taskIds is list && d.taskIds.size() <= 20 && d.createdBy is string && d.createdAt is number;
    }
    function validRequirement(d) {
      return d.keys().hasOnly(['ref', 'title', 'detail', 'priority', 'status', 'taskIds', 'verification', 'verified', 'verifiedBy', 'verifiedDate', 'createdBy', 'createdByName', 'createdAt', 'updatedAt'])
        && d.ref is string && d.ref.size() <= 20 && d.title is string && d.title.size() > 0 && d.title.size() <= 300 && d.detail is string && d.detail.size() <= 3000
        && d.priority in ['must', 'should', 'could'] && d.status in ['draft', 'agreed', 'met', 'dropped']
        && d.taskIds is list && d.taskIds.size() <= 30 && d.verification is string && d.verification.size() <= 1000 && d.verified is bool
        && d.createdBy is string && d.createdAt is number;
    }
    function validLog(d) {
      return d.keys().hasOnly(['at', 'by', 'byName', 'kind', 'text'])
        && d.at is number && d.by == request.auth.uid && d.byName is string && d.byName.size() <= 80
        && d.kind in ['budget', 'spending', 'income', 'parts'] && d.text is string && d.text.size() > 0 && d.text.size() <= 600;
    }
    // Plans are changed by the team's Owner and Admins only (not custom roles).
    function ownerOrAdmin(t) { return isMember(t) && myRole(t) in ['owner', 'admin']; }
    function canEditAny(t) { return can(t, 'tasks.editOwn') || can(t, 'tasks.editAll'); }
    function seesMoney(t) { return can(t, 'finance.view') || can(t, 'finance.edit'); }
    function validTemplate(d) {
      return d.keys().hasOnly(['name', 'task', 'createdBy', 'createdByName', 'createdAt'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 80
        && d.task is map && d.createdBy is string && d.createdAt is number;
    }
    function validCat(d) {
      return d.keys().hasOnly(['name', 'ownerUid', 'order'])
        && d.name is string && d.name.size() <= 80 && d.ownerUid is string && d.order is number;
    }
    function validTask(d) {
      return d.keys().hasOnly(['name', 'priority', 'status', 'jiraId', 'supportPersonId', 'supportPersonId2', 'flag',
          'dueDate', 'startDate', 'checks', 'signoff', 'phaseId', 'repeat', 'stage', 'effort', 'dependsOn', 'carryOf', 'skill', 'timeLog', 'completedDate', 'subtasks', 'history', 'custom', 'icon', 'attachments',
          'categoryId', 'ownerUid', 'weekId', 'order', 'createdBy', 'createdAt', 'updatedBy', 'updatedAt'])
        && d.name is string && d.name.size() <= 500
        && d.priority in ['Minor', 'Major', 'Critical', 'Blocker']
        && d.flag in ['none', 'pending', 'backlog', 'completed']
        && d.categoryId is string && d.ownerUid is string && d.weekId is string && d.order is number
        && d.subtasks is list && d.subtasks.size() <= 100
        && d.history is list && d.history.size() <= 100
        && d.custom is map && d.attachments is list && d.attachments.size() <= 30
        && d.icon is string && d.icon.size() <= 40000
        && d.get('phaseId', '') is string && d.get('phaseId', '').size() <= 64
        && (d.get('repeat', null) == null || d.get('repeat', null) is map)
        && d.get('stage', '') is string && d.get('stage', '').matches('^[A-Za-z0-9_-]{0,40}$')
        && (d.get('effort', null) == null || (d.get('effort', null) is number && d.get('effort', 0) >= 0 && d.get('effort', 0) <= 999))
        && d.get('dependsOn', []) is list && d.get('dependsOn', []).size() <= 10
        && d.get('carryOf', '') is string && d.get('carryOf', '').size() <= 64
        && d.get('startDate', '') is string && d.get('startDate', '').size() <= 10
        && d.get('skill', '') is string && d.get('skill', '').size() <= 40
        && d.get('timeLog', []) is list && d.get('timeLog', []).size() <= 200
        && d.get('checks', {}) is map && d.get('checks', {}).size() <= 50
        && validSignoff(d.get('signoff', null));
    }
    // A sign-off on a task: who asked, and (once decided) who decided. A decision (approved or changes
    // requested) can only be recorded by the person it names as the approver.
    // The person asked to sign off a task may record their decision (and move it on when approved),
    // even if they can't otherwise edit that task. Nothing else about the task may change.
    function signoffDecision(t) {
      return isMember(t)
        && resource.data.get('signoff', null) != null && resource.data.signoff.get('status', '') == 'waiting'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['signoff', 'stage', 'flag', 'completedDate', 'history', 'updatedBy', 'updatedAt'])
        && request.resource.data.get('signoff', null) != null
        && request.resource.data.signoff.get('status', '') in ['approved', 'changes']
        && request.resource.data.signoff.get('approver', '') == request.auth.uid
        && validTask(request.resource.data);
    }
    // Sign-off gates (src/model.js ▸ workflowIndex): a task can only move forward past a stage that
    // needs a sign-off when it carries that sign-off, given by someone allowed to give it.
    function wfOrd(wf, d) {
      return d.get('flag', 'none') == 'completed' ? wf.done : wf.order.get(d.get('stage', ''), 0);
    }
    function approvedOrd(wf, d) {
      return d.get('signoff', null) != null && d.signoff.get('status', '') == 'approved' ? wf.order.get(d.signoff.get('stage', ''), -1) : -1;
    }
    // Moving from position `from` to `to`: the first sign-off stage on the way must be beyond `to`,
    // or be the one approved (`a`) with the next one beyond `to`. (A task carries one approval.)
    function gatesPassed(wf, from, to, a) {
      return to <= from || wf.next[from] >= to || (a >= 0 && wf.next[from] == a && wf.next[a + 1] >= to);
    }
    // Allowed to sign off this gate for a task owned by `owner`? Never your own task (unless you own
    // the team); 'lead' = the owner's sub-team leads (else admins); 'person' = them or an admin.
    function canSign(t, g, owner) {
      let team = get(teamPath(t)).data;
      let admin = myRole(t) in ['owner', 'admin'];
      let leads = team.get('leads', {}).get(owner, []);
      return g != null && (team.ownerUid == request.auth.uid || (request.auth.uid != owner && (
        g.k == 'admin' ? admin : (g.k == 'person' ? (request.auth.uid == g.s || admin) : (leads.size() > 0 ? request.auth.uid in leads : admin)))));
    }
    function signoffGates(t) {
      let wf = get(teamPath(t)).data.get('workflow', null);
      let v = request.resource.data.get('signoff', null);
      return wf == null || !('next' in wf) || (
        gatesPassed(wf, wfOrd(wf, resource.data), wfOrd(wf, request.resource.data), approvedOrd(wf, request.resource.data))
        && (v == null || v.get('status', '') == 'waiting' || resource.data.get('signoff', null) == v
          || canSign(t, wf.gates.get(v.get('stage', ''), null), request.resource.data.ownerUid)));
    }
    function validSignoff(v) {
      return v == null || (v is map
        && v.keys().hasOnly(['stage', 'status', 'by', 'byName', 'at', 'approver', 'approverName', 'note', 'decidedAt', 'remindedAt'])
        && v.get('status', '') in ['waiting', 'approved', 'changes']
        && v.get('note', '') is string && v.get('note', '').size() <= 500
        && v.get('stage', '') is string && v.get('stage', '').size() <= 40
        && (v.status == 'waiting'
          || (resource != null && resource.data.get('signoff', null) == v)
          || v.get('approver', '') == request.auth.uid));
    }

    // "Which teams am I in?" (collection-group query on members, filtered by my uid)
    match /{path=**}/members/{uid} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
    }
    // "Which invitations are waiting for me?" (only for a VERIFIED email address)
    match /{path=**}/invites/{email} {
      allow read: if signedIn() && verified() && resource.data.email == myEmail();
    }

    // Your own profile (account photo). Only you can read or change it; teammates see the
    // copy on your membership in each team.
    match /users/{uid} {
      allow read, delete: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['photo', 'theme', 'menuStyle', 'nav', 'notify', 'updatedAt'])
        && request.resource.data.get('notify', {}) is map && request.resource.data.get('notify', {}).size() <= 5
        && request.resource.data.get('menuStyle', 'list') in ['list', 'circle']
        && request.resource.data.get('nav', 'top') in ['top', 'side']
        && validPhoto(request.resource.data)
        && request.resource.data.get('theme', '') is string && request.resource.data.get('theme', '').size() <= 40;
    }

    // SelfTrack: one person's own tasks, habits, skills, learnings and reflections (src/self-model.js).
    // Only that person can ever read or write them; no team, admin or other account can.
    function validSelf(d) {
      return d.keys().hasOnly(['uid', 'kind', 'title', 'area', 'scope', 'date', 'done', 'doneOn', 'order', 'createdAt', 'updatedAt',
          'note', 'log', 'goal', 'skillId', 'mood', 'well', 'hard', 'areas', 'sync', 'archived', 'color'])
        && d.uid == request.auth.uid
        && d.kind in ['task', 'habit', 'skill', 'learning', 'reflect', 'settings']
        && d.get('title', '') is string && d.get('title', '').size() <= 300
        && d.get('area', '') is string && d.get('area', '').size() <= 40
        && d.get('note', '') is string && d.get('note', '').size() <= 2000
        && d.get('well', '') is string && d.get('well', '').size() <= 2000
        && d.get('hard', '') is string && d.get('hard', '').size() <= 2000
        && d.get('date', '') is string && d.get('date', '').size() <= 10
        && d.get('doneOn', '') is string && d.get('doneOn', '').size() <= 10
        && d.get('skillId', '') is string && d.get('skillId', '').size() <= 64
        && d.get('color', '') is string && d.get('color', '').size() <= 20
        && d.get('scope', 'day') in ['day', 'week']
        && d.get('done', false) is bool && d.get('archived', false) is bool
        && d.get('goal', 0) is number && d.get('mood', 0) is number && d.get('order', 0) is number
        && d.get('log', []) is list && d.get('log', []).size() <= 800
        && d.get('areas', []) is list && d.get('areas', []).size() <= 12
        && d.get('sync', {}) is map && d.get('sync', {}).size() <= 50;
    }
    match /selfItems/{id} {
      allow read, delete: if signedIn() && resource.data.uid == request.auth.uid;
      allow create: if signedIn() && validSelf(request.resource.data);
      allow update: if signedIn() && resource.data.uid == request.auth.uid && validSelf(request.resource.data);
    }

    // Pro Education claims: the teams each person switched it on for this year. Only ever added to within a year.
    match /eduClaims/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid && academic()
        && request.resource.data.keys().hasOnly(['year', 'teams'])
        && request.resource.data.year == request.time.year()
        && request.resource.data.teams is list && request.resource.data.teams.size() <= 25
        && (resource == null || resource.data.year != request.time.year() || request.resource.data.teams.hasAll(resource.data.teams));
      allow delete: if false;
    }
    // Error reports from browsers (no personal data). Deleted automatically after 30 days (TTL on expireAt).
    // Feedback from the in-app button. Emailed to the platform admins by a Cloud Function.
    match /feedback/{id} {
      allow read, delete: if isPlatformAdmin();
      allow create: if signedIn() && request.resource.data.keys().hasOnly(['kind', 'text', 'where', 'teamId', 'ua', 'build', 'at', 'uid', 'email', 'name', 'errors', 'expireAt'])
        && request.resource.data.uid == request.auth.uid && request.resource.data.kind in ['bug', 'idea', 'question', 'other']
        && request.resource.data.text is string && request.resource.data.text.size() >= 1 && request.resource.data.text.size() <= 2000
        && request.resource.data.where is string && request.resource.data.where.size() <= 100
        && request.resource.data.teamId is string && request.resource.data.teamId.size() <= 64
        && request.resource.data.ua is string && request.resource.data.ua.size() <= 200
        && request.resource.data.build is string && request.resource.data.build.size() <= 40
        && request.resource.data.name is string && request.resource.data.name.size() <= 80
        && (request.resource.data.email == '' || request.resource.data.email == request.auth.token.email)
        && request.resource.data.errors is list && request.resource.data.errors.size() <= 5
        && request.resource.data.expireAt is timestamp;
      allow update: if false;
    }
    // Pilot numbers per team (counts only), written by the dailyTeamStats function.
    match /teamStats/{id} {
      allow read: if isPlatformAdmin();
      allow write: if false;
    }
    match /clientErrors/{id} {
      allow read, delete: if isPlatformAdmin();
      allow create: if signedIn() && request.resource.data.keys().hasOnly(['kind', 'msg', 'stack', 'where', 'ua', 'build', 'at', 'uid', 'expireAt'])
        && request.resource.data.uid == request.auth.uid && request.resource.data.kind in ['error', 'promise', 'write']
        && request.resource.data.msg is string && request.resource.data.msg.size() <= 300
        && request.resource.data.stack is string && request.resource.data.stack.size() <= 2000
        && request.resource.data.ua is string && request.resource.data.ua.size() <= 200
        && request.resource.data.expireAt is timestamp;
      allow update: if false;
    }
    // A university email proved by a code (written by the server's Cloud Functions only).
    match /verifiedStudents/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }
    // Pro requests from every team, for the platform admin's list.
    match /{path=**}/requests/{r} {
      allow read: if isPlatformAdmin();
    }

    match /teams/{t} {
      allow read: if isMember(t) || isPlatformAdmin();
      allow create: if signedIn() && validTeam(request.resource.data)
        && request.resource.data.ownerUid == request.auth.uid
        && (!('plan' in request.resource.data) || request.resource.data.plan.tier == 'free');
      // Students and staff with a verified university email turn on free Pro Education (up to 400 days at a time).
      // Only the team's OWNER (not an admin or member) can, so a student can't be invited just to unlock it.
      allow update: if academic() && isMember(t) && myRole(t) == 'owner'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['plan'])
        && validPlan(request.resource.data.plan) && request.resource.data.plan.tier == 'pro' && request.resource.data.plan.edu == true
        && request.resource.data.plan.by == request.auth.uid && request.resource.data.plan.until > request.time.toMillis()
        && request.resource.data.plan.until <= request.time.toMillis() + 400 * 86400000
        && resource.data.get('plan', {'tier': 'free'}).tier != 'org'
        && eduClaimed(t);
      // Otherwise only a platform admin (or later, the payment system) changes a team's plan.
      allow update: if isPlatformAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['plan'])
        && validPlan(request.resource.data.plan) && request.resource.data.plan.by == request.auth.uid;
      allow update: if isMember(t) && validTeam(request.resource.data)
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.createdAt == resource.data.createdAt
        && changed().hasOnly(['weeks', 'name', 'logo', 'fields', 'labels', 'roles', 'weekNaming', 'phases', 'capacity', 'features', 'subteams', 'archiveRev', 'workflow', 'leads', 'purchase', 'autos', 'github', 'currency', 'former', 'look'])
        // archiveRev: changed by any save to an old week, so other devices re-read old weeks (backend/tasksync.js)
        && (!changed().hasAny(['archiveRev']) || can(t, 'tasks.editOwn') || can(t, 'tasks.editAll'))
        && (!changed().hasAny(['subteams', 'leads']) || can(t, 'team.settings') || can(t, 'members.manage'))
        && (!changed().hasAny(['weeks']) || can(t, 'weeks.manage'))
        && (!changed().hasAny(['name', 'logo', 'fields', 'labels', 'weekNaming', 'phases', 'capacity', 'features', 'workflow', 'look']) || can(t, 'team.settings'))
        && (!changed().hasAny(['roles']) || can(t, 'roles.manage'))
        // who used to be in the team (names stay on their past work): set when a member is removed
        && (!changed().hasAny(['former']) || can(t, 'members.manage'))
        && (!changed().hasAny(['autos', 'github']) || can(t, 'team.settings'))
        // The repository itself is set by the server (githubConnect), which also keeps its secret.
        && (!changed().hasAny(['github']) || (request.resource.data.get('github', null) == null || (request.resource.data.github.get('repo', '') == resource.data.get('github', {}).get('repo', '')
          && request.resource.data.github.get('write', false) == resource.data.get('github', {}).get('write', false))))
        && (!changed().hasAny(['purchase', 'currency']) || can(t, 'team.settings') || can(t, 'finance.edit'));
      allow delete: if isMember(t) && myRole(t) == 'owner';

      // Server-only secrets (the GitHub webhook secret): nobody reads them; the owner can delete them with the team.
      match /private/{d} {
        allow read, create, update: if false;
        allow delete: if isMember(t) && myRole(t) == 'owner';
      }
      // A request for Pro, made by someone who manages the team's settings.
      match /requests/{r} {
        allow read: if isMember(t) || isPlatformAdmin();
        allow create, update: if r == 'pro' && ownerOrAdmin(t) && validPlanRequest(request.resource.data) && request.resource.data.teamId == t;
        // A member asking the team's owner and admins to switch on Pro (Education).
        allow create: if isMember(t) && r == 'ask-' + request.auth.uid
          && request.resource.data.keys().hasOnly(['by', 'byName', 'at', 'note']) && request.resource.data.by == request.auth.uid
          && request.resource.data.note is string && request.resource.data.note.size() <= 300;
        allow update: if isPlatformAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'decidedAt'])
          && request.resource.data.status in ['approved', 'declined'];
        allow delete: if ownerOrAdmin(t) || isPlatformAdmin() || r == 'ask-' + request.auth.uid;
        // Leaving the team: a member asks, and the owner or someone who manages members approves.
        allow create: if isMember(t) && myRole(t) != 'owner' && r == 'leave-' + request.auth.uid
          && request.resource.data.keys().hasOnly(['kind', 'by', 'byName', 'at', 'note']) && request.resource.data.kind == 'leave'
          && request.resource.data.by == request.auth.uid && request.resource.data.byName is string && request.resource.data.byName.size() <= 80
          && request.resource.data.note is string && request.resource.data.note.size() <= 300;
        allow delete: if isMember(t) && (r == 'leave-' + request.auth.uid || (r.matches('^leave-.+') && can(t, 'members.manage')));
        // Deleting a task: someone who may only edit their own tasks asks; someone who edits everyone's approves.
        allow create: if isMember(t) && r == 'del-' + request.resource.data.taskId
          && request.resource.data.keys().hasOnly(['kind', 'by', 'byName', 'at', 'note', 'taskId', 'taskName']) && request.resource.data.kind == 'delete'
          && request.resource.data.by == request.auth.uid && request.resource.data.byName is string && request.resource.data.byName.size() <= 80
          && request.resource.data.note is string && request.resource.data.note.size() <= 300
          && request.resource.data.taskName is string && request.resource.data.taskName.size() <= 200
          && exists(/databases/$(database)/documents/teams/$(t)/tasks/$(request.resource.data.taskId))
          && canEditOwned(t, get(/databases/$(database)/documents/teams/$(t)/tasks/$(request.resource.data.taskId)).data.ownerUid);
        allow delete: if isMember(t) && r.matches('^del-.+') && (can(t, 'tasks.editAll') || resource.data.by == request.auth.uid);
      }

      match /members/{uid} {
        allow read: if isMember(t);
        allow create: if signedIn() && uid == request.auth.uid
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.keys().hasOnly(['uid', 'email', 'name', 'photo', 'roleId', 'joinedAt'])
          && request.resource.data.name is string && request.resource.data.name.size() <= 80
          && validPhoto(request.resource.data)
          && (
            // founder: created in the same batch as a brand-new team they own
            (request.resource.data.roleId == 'owner' && !exists(teamPath(t))
              && getAfter(teamPath(t)).data.ownerUid == request.auth.uid)
            // invitee: an invitation exists for my verified email, with this role
            || (verified() && request.resource.data.email == myEmail()
              && exists(/databases/$(database)/documents/teams/$(t)/invites/$(myEmail()))
              && request.resource.data.roleId == get(/databases/$(database)/documents/teams/$(t)/invites/$(myEmail())).data.roleId
              && request.resource.data.roleId != 'owner')
          );
        allow update: if isMember(t) && (
            // managers change someone else's role (never the owner, never to owner)
            (can(t, 'members.manage') && uid != request.auth.uid && changed().hasOnly(['roleId'])
              && resource.data.roleId != 'owner' && request.resource.data.roleId != 'owner'
              && request.resource.data.roleId in get(teamPath(t)).data.roles)
            // anyone updates their own display name / photo
            || (uid == request.auth.uid && changed().hasOnly(['name', 'photo'])
              && request.resource.data.name is string && request.resource.data.name.size() <= 80 && validPhoto(request.resource.data))
          );
        allow delete: if isMember(t) && (
            // leaving needs approval: only someone who manages members removes a membership (their own included)
            (resource.data.roleId != 'owner' && can(t, 'members.manage'))
            // the owner's membership goes only together with the team itself
            || (resource.data.roleId == 'owner' && uid == request.auth.uid && !existsAfter(teamPath(t)))
          );
      }

      match /invites/{email} {
        allow read: if can(t, 'members.manage') || (signedIn() && verified() && email == myEmail());
        allow create, update: if can(t, 'members.manage')
          && request.resource.data.keys().hasOnly(['email', 'roleId', 'teamName', 'invitedBy', 'invitedByName', 'createdAt'])
          && request.resource.data.email == email
          && email.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]{2,}$')
          && request.resource.data.roleId != 'owner'
          && request.resource.data.roleId in get(teamPath(t)).data.roles
          // in your own name, with names of sensible length (they go into the invitation email)
          && request.resource.data.get('invitedBy', '') == request.auth.uid
          && request.resource.data.get('invitedByName', '') is string && request.resource.data.get('invitedByName', '').size() <= 80
          && request.resource.data.get('teamName', '') is string && request.resource.data.get('teamName', '').size() <= 80
          && request.resource.data.get('createdAt', 0) is number;
        allow delete: if can(t, 'members.manage') || (signedIn() && verified() && email == myEmail());
      }

      match /categories/{c} {
        allow read: if isMember(t);
        allow create: if canEditOwned(t, request.resource.data.ownerUid) && validCat(request.resource.data);
        allow update: if canEditOwned(t, resource.data.ownerUid)
          && canEditOwned(t, request.resource.data.ownerUid) && validCat(request.resource.data);
        allow delete: if canEditOwned(t, resource.data.ownerUid);
      }

      // Comments on tasks. Anyone who can edit tasks can comment; viewers read only.
      // Authors edit their own text; authors or member managers delete.
      match /comments/{c} {
        allow read: if isMember(t);
        allow create: if (can(t, 'tasks.editOwn') || can(t, 'tasks.editAll'))
          && request.resource.data.authorUid == request.auth.uid && validComment(request.resource.data);
        allow update: if isMember(t) && resource.data.authorUid == request.auth.uid
          && changed().hasOnly(['text', 'mentions', 'editedAt']) && validComment(request.resource.data);
        allow delete: if isMember(t) && (resource.data.authorUid == request.auth.uid || can(t, 'members.manage'));
      }

      // Task templates: anyone who can add tasks saves one; its author or a settings manager edits or deletes it.
      match /templates/{tpl} {
        allow read: if isMember(t);
        allow create: if (can(t, 'tasks.editOwn') || can(t, 'tasks.editAll'))
          && request.resource.data.createdBy == request.auth.uid && validTemplate(request.resource.data);
        allow update: if (resource.data.createdBy == request.auth.uid || can(t, 'team.settings'))
          && request.resource.data.createdBy == resource.data.createdBy && validTemplate(request.resource.data);
        allow delete: if resource.data.createdBy == request.auth.uid || can(t, 'team.settings');
      }

      // Meeting notes: anyone who can edit tasks writes them together; the author or a settings manager deletes.
      match /meetings/{m} {
        allow read: if isMember(t);
        allow create: if canEditAny(t) && request.resource.data.createdBy == request.auth.uid && validMeeting(request.resource.data);
        allow update: if canEditAny(t) && request.resource.data.createdBy == resource.data.createdBy && validMeeting(request.resource.data);
        allow delete: if isMember(t) && (resource.data.createdBy == request.auth.uid || can(t, 'team.settings'));
      }
      // Lab notebook entries on tasks: written like comments; only the author edits.
      match /notebook/{n} {
        allow read: if isMember(t);
        allow create: if canEditAny(t) && request.resource.data.authorUid == request.auth.uid && validNote(request.resource.data);
        allow update: if isMember(t) && resource.data.authorUid == request.auth.uid
          && request.resource.data.authorUid == resource.data.authorUid && validNote(request.resource.data);
        allow delete: if isMember(t) && (resource.data.authorUid == request.auth.uid || can(t, 'members.manage'));
      }
      // Parts and orders: a shared list everyone who can edit tasks keeps up to date.
      match /parts/{p} {
        allow read: if isMember(t);
        allow create: if canEditAny(t) && request.resource.data.createdBy == request.auth.uid && validPart(request.resource.data)
          && partApproval(t) && purchaseOk(t);
        allow update: if (canEditAny(t) || can(t, 'finance.edit')) && request.resource.data.createdBy == resource.data.createdBy && validPart(request.resource.data)
          && (request.resource.data.get('budgetId', '') == resource.data.get('budgetId', '') || seesMoney(t))
          && partApproval(t) && purchaseOk(t) && costKept(t);
        allow delete: if isMember(t) && (resource.data.createdBy == request.auth.uid || can(t, 'team.settings'));
      }
      // Each member's working profile (hours a week, skills, time off): they edit their own; member managers edit anyone's.
      // Who's here: each person writes only their own (online heartbeat, status, the task they have open).
      match /presence/{uid} {
        allow read: if isMember(t);
        allow create, update: if isMember(t) && uid == request.auth.uid
          && request.resource.data.keys().hasOnly(['at', 'state', 'note', 'until', 'taskId'])
          && request.resource.data.at is number && request.resource.data.at <= request.time.toMillis() + 120000
          && request.resource.data.state in ['', 'free', 'busy', 'away']
          && request.resource.data.note is string && request.resource.data.note.size() <= 80
          && request.resource.data.until is number && request.resource.data.taskId is string && request.resource.data.taskId.size() <= 64;
        allow delete: if isMember(t) && (uid == request.auth.uid || can(t, 'members.manage'));
      }
      // Live cursors: where each person is pointing on the board. Only your own, small and short-lived.
      match /cursors/{uid} {
        allow read: if isMember(t);
        allow create, update: if isMember(t) && uid == request.auth.uid
          && request.resource.data.keys().hasOnly(['at', 'a', 'fx', 'fy', 'view', 'name'])
          && request.resource.data.at is number && request.resource.data.at <= request.time.toMillis() + 120000
          && request.resource.data.a is string && request.resource.data.a.size() <= 66
          && request.resource.data.fx is number && request.resource.data.fy is number
          && request.resource.data.view is string && request.resource.data.view.size() <= 12
          && request.resource.data.name is string && request.resource.data.name.size() <= 60;
        allow delete: if isMember(t) && (uid == request.auth.uid || can(t, 'members.manage'));
      }
      match /profiles/{uid} {
        allow read: if isMember(t);
        allow create, update: if isMember(t) && (uid == request.auth.uid || can(t, 'members.manage')) && validProfile(request.resource.data);
        allow delete: if isMember(t) && (uid == request.auth.uid || can(t, 'members.manage'));
      }
      // Risk register and requirements: shared engineering records.
      // Whiteboards: anyone who can edit tasks can draw on any board (it's shared); the board's
      // creator (or team settings) deletes the board itself.
      match /whiteboards/{b} {
        allow read: if isMember(t);
        allow create: if canEditAny(t) && request.resource.data.createdBy == request.auth.uid && validWhiteboard(request.resource.data);
        allow update: if canEditAny(t) && request.resource.data.createdBy == resource.data.createdBy && validWhiteboard(request.resource.data);
        allow delete: if isMember(t) && (resource.data.createdBy == request.auth.uid || can(t, 'team.settings'));
      }
      match /wbItems/{i} {
        allow read: if isMember(t);
        allow create: if canEditAny(t) && request.resource.data.createdBy == request.auth.uid && validWbItem(request.resource.data);
        allow update: if canEditAny(t) && request.resource.data.createdBy == resource.data.createdBy && validWbItem(request.resource.data);
        allow delete: if canEditAny(t);
      }
      match /risks/{r} {
        allow read: if isMember(t);
        allow create: if canEditAny(t) && request.resource.data.createdBy == request.auth.uid && validRisk(request.resource.data);
        allow update: if canEditAny(t) && request.resource.data.createdBy == resource.data.createdBy && validRisk(request.resource.data);
        allow delete: if isMember(t) && (resource.data.createdBy == request.auth.uid || can(t, 'team.settings'));
      }
      match /requirements/{q} {
        allow read: if isMember(t);
        allow create: if canEditAny(t) && request.resource.data.createdBy == request.auth.uid && validRequirement(request.resource.data);
        allow update: if canEditAny(t) && request.resource.data.createdBy == resource.data.createdBy && validRequirement(request.resource.data);
        allow delete: if isMember(t) && (resource.data.createdBy == request.auth.uid || can(t, 'team.settings'));
      }
      // Literature list: shared; the person who added an item or a settings manager deletes it.
      // A dissertation or thesis workspace (the Dissertation feature): one document, 'plan'. Kept apart
      // from the team document so the team's own rules stay small.
      match /dissertation/{d} {
        allow read: if isMember(t);
        allow create, update: if d == 'plan' && can(t, 'team.settings') && validDissertation(request.resource.data);
        allow delete: if can(t, 'team.settings');
      }
      match /papers/{p} {
        allow read: if isMember(t);
        allow create: if canEditAny(t) && request.resource.data.addedBy == request.auth.uid && validPaper(request.resource.data);
        allow update: if canEditAny(t) && request.resource.data.addedBy == resource.data.addedBy && validPaper(request.resource.data);
        allow delete: if isMember(t) && (resource.data.addedBy == request.auth.uid || can(t, 'team.settings'));
      }
      // Money: only roles with the finance permissions see or change it.
      match /expenses/{x} {
        allow read: if seesMoney(t);
        allow create: if can(t, 'finance.edit') && request.resource.data.createdBy == request.auth.uid && validExpense(request.resource.data);
        allow update: if can(t, 'finance.edit') && request.resource.data.createdBy == resource.data.createdBy && validExpense(request.resource.data);
        allow delete: if can(t, 'finance.edit');
      }
      // Finance history: anyone who changes money or parts adds a line; nobody can edit or remove one.
      match /financeLog/{e} {
        allow read: if seesMoney(t);
        allow create: if (canEditAny(t) || can(t, 'finance.edit')) && validLog(request.resource.data);
        allow update: if false;
        allow delete: if isMember(t) && myRole(t) == 'owner';
      }
      match /finance/{doc} {
        allow read: if seesMoney(t);
        allow create, update: if can(t, 'finance.edit') && doc == 'budget' && validBudget(request.resource.data);
        allow delete: if can(t, 'finance.edit');
      }

      match /tasks/{task} {
        allow read: if isMember(t);
        // who made it and when can't be forged or changed later (deleting without approval depends on them)
        // A new task never arrives already signed off (an approval is given on the task, by the approver)
        allow create: if canEditOwned(t, request.resource.data.ownerUid) && validTask(request.resource.data)
          && (request.resource.data.get('signoff', null) == null || request.resource.data.signoff.get('status', '') == 'waiting')
          && request.resource.data.get('createdBy', '') == request.auth.uid && request.resource.data.get('createdAt', 0) <= request.time.toMillis() + 300000
          && getAfter(/databases/$(database)/documents/teams/$(t)/categories/$(request.resource.data.categoryId)).data.ownerUid == request.resource.data.ownerUid;
        allow update: if ((canEditOwned(t, resource.data.ownerUid)
          && canEditOwned(t, request.resource.data.ownerUid) && validTask(request.resource.data)
          && request.resource.data.get('createdBy', '') == resource.data.get('createdBy', '') && request.resource.data.get('createdAt', 0) == resource.data.get('createdAt', 0)
          && getAfter(/databases/$(database)/documents/teams/$(t)/categories/$(request.resource.data.categoryId)).data.ownerUid == request.resource.data.ownerUid)
          || signoffDecision(t)) && signoffGates(t);
        // Deleting: those who edit everyone's tasks; others only a task they made in the last day (anything older is asked for)
        allow delete: if can(t, 'tasks.editAll')
          || (canEditOwned(t, resource.data.ownerUid) && resource.data.get('createdBy', '') == request.auth.uid
            && resource.data.get('createdAt', 0) > request.time.toMillis() - 86400000);
      }
    }
  }
}
